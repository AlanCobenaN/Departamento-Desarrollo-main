# Origen de la API PHP, tal y como lo lee frontend/src/utils/api.js.
#
# En desarrollo: el servidor de PHP levantado con
#   php -S localhost:8000 -t api/public
#
# En produccion debe apuntar al dominio donde este publicada la API, porque el
# sitio se compila antes de desplegarse y este valor queda incrustado en el
# JavaScript. Sin el, el frontend usa el catalogo de respaldo y nunca consulta
# la base de datos.
VITE_API_URL=http://localhost:8000/api
