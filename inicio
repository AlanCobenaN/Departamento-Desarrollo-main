#!/usr/bin/env bash
#
# inicio — levanta la API y el frontend de una sola vez.
#
# Es un atajo de `npm run dev` con las comprobaciones previas que siempre
# hay que hacer a mano: .env, dependencias y puertos libres.
#
#   ./inicio                 # usa los puertos de los .env (4000 y 5173)
#   FRONT_PORT=5175 ./inicio  # frontend en otro puerto
#
set -euo pipefail

# Para que funcione desde cualquier directorio.
cd "$(dirname "$(readlink -f "$0")")"

FRONT_PORT="${FRONT_PORT:-5173}"

info() { printf '\033[36m▸\033[0m %s\n' "$1"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$1"; }
die()  { printf '\033[31m✗ %s\033[0m\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------- Node ----
command -v node >/dev/null 2>&1 || die "Node no está instalado. Instálalo desde https://nodejs.org (>= 18)."

if ! node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>18||(a===18&&b>=0)?0:1)'; then
  die "Node $(node -v) es demasiado antiguo. El proyecto pide >= 18."
fi

# --------------------------------------------------------------- .env ----
# El backend trae valores por defecto, pero sin .env el origen de CORS y
# la URL de la API no quedan declarados y fallan al mover cualquier valor.
for ws in backend frontend; do
  if [ ! -f "$ws/.env" ] && [ -f "$ws/.env.example" ]; then
    cp "$ws/.env.example" "$ws/.env"
    ok "Creado $ws/.env desde $ws/.env.example"
  fi
done

# El puerto de la API se lee del .env real, no de una variable suelta: si el
# .env dice PORT=4001 hay que anunciar 4001, no 4000.
API_PORT="$(sed -n 's/^[[:space:]]*PORT=[[:space:]]*//p' backend/.env 2>/dev/null | head -1 | tr -d '"'\''[:space:]' || true)"
[ -n "$API_PORT" ] || API_PORT=4000

# -------------------------------------------------------- dependencias ----
if [ ! -d node_modules ]; then
  info "Faltan dependencias, instalando (puede tardar)..."
  npm ci || npm install
  ok "Dependencias instaladas"
fi

[ -x node_modules/.bin/concurrently ] || die "Falta concurrently. Corre: npm install"

# ------------------------------------------------------------- puertos ----
# Se comprueba con Node porque es la única herramienta que el proyecto ya
# garantiza; lsof y ss no están en todos los sistemas.
#
# El bind va sin host a propósito: así es dual-stack y detecta también a
# quien escucha solo en IPv6. Vite resuelve "localhost" a ::1, así que un
# proceso atado a [::1]:5173 (el caso típico de otro dev server en la
# máquina) delata un puerto ocupado que un bind a 127.0.0.1 no vería, y
# Vite se mudaría al 5174 sin avisar.
port_libre() {
  node -e '
    const net = require("net");
    const s = net.createServer();
    s.once("error", () => process.exit(1));
    s.listen(Number(process.argv[1]), () => s.close(() => process.exit(0)));
  ' "$1"
}

ocupado=""
for p in "$API_PORT" "$FRONT_PORT"; do
  port_libre "$p" || ocupado="$ocupado $p"
done

if [ -n "$ocupado" ]; then
  die "Puertos ocupados:$ocupado. Cierra lo que los esté usando, o cambia PORT en backend/.env / FRONT_PORT=... al llamar a este script."
fi

# ------------------------------------------------------------- arranque ----
info "API en http://localhost:$API_PORT  ·  Frontend en http://localhost:$FRONT_PORT"
printf '\n'

# Se llama a concurrently con los comandos completos en vez de usar
# `npm run dev`. El atajo `npm:dev:frontend` de la raiz no reenvia
# argumentos, y --strictPort es justamente lo que evita que Vite se mueva
# de puerto en silencio y deje la URL de arriba mintiendo.
cleanup() {
  trap - INT TERM EXIT
  [ -n "${APP_PID:-}" ] && kill "$APP_PID" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

node_modules/.bin/concurrently -k -n API,FRONT -c red,cyan \
  "npm run dev --workspace backend" \
  "npm run dev --workspace frontend -- --port $FRONT_PORT --strictPort" &
APP_PID=$!
wait "$APP_PID"
