{
  "name": "fcvt-equipo-desarrollo",
  "private": true,
  "version": "1.0.0",
  "description": "Sitio corporativo del equipo interno de desarrollo de la Facultad de Ciencias de la Vida y Tecnologías (FCVT) - ULEAM. Frontend en Node, API en PHP y datos en PostgreSQL.",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "inicio": "node inicio.mjs",
    "dev": "node inicio.mjs",
    "dev:api": "php -S localhost:8000 -t api/public",
    "dev:frontend": "npm run dev --workspace frontend",
    "catalogo": "php api/database/export.php",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "engines": {
    "node": ">=18.0.0",
    "php": ">=8.1",
    "postgres": ">=14"
  }
}
