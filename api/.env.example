# Configuracion de la API PHP.
# Copiar este archivo a .env y ajustar los valores.
#
# Las variables ya definidas en el entorno real tienen prioridad sobre las de
# aqui, asi que en un hosting se pueden sobreescribir sin editar el archivo.

# --- PostgreSQL -------------------------------------------------------------

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fcvt
DB_USER=postgres
DB_PASSWORD=

# --- Servidor ---------------------------------------------------------------

# Puerto del servidor de desarrollo de PHP. Lo lee inicio.mjs para levantarlo
# y para comprobar que esta libre. npm run dev:api usa 8000 directamente.
API_PORT=8000

# Origenes permitidos por CORS, separados por coma. En produccion: el dominio
# publico. Durante las pruebas se puede dejar la lista de los dos.
CLIENT_ORIGIN=http://localhost:5173

# Ruta bajo la que se publica la API. /api mantiene la misma URL que usaba la
# version de Express, asi que el frontend no cambia. Ponlo en / si el hosting
# la sirve en la raiz del dominio.
API_PREFIX=/api

# Muestra el detalle real de los errores 500. Dejalo en false fuera de
# desarrollo: en la respuesta solo debe verse un mensaje generico.
APP_DEBUG=false
